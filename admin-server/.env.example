# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workguard
DB_USER=postgres
DB_PASSWORD=changeme

# AES-256-GCM Encryption Key (Base64-encoded 32-byte key for employee-admin communication)
# Generate with: python -c "import os; import base64; print(base64.b64encode(os.urandom(32)).decode())"
WORKGUARD_AES_KEY_BASE64=changeme

# Ollama LLM Configuration
WORKGUARD_OLLAMA_URL=http://localhost:11434
WORKGUARD_OLLAMA_MODEL=llama2:latest

# Embedding Model Configuration
WORKGUARD_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
